# Local Cloud-Agent dev environment variables (non-secret).
#
# These point the FastAPI backend at the local MariaDB started by
# .cursor/start.sh. They are intentionally NOT real credentials — the
# production MySQL/Entra/GCS secrets live in GCP Secret Manager and are never
# needed for local development. The frontend runs against MSW mocks and does
# not use these at all.

# Local MariaDB (started by .cursor/start.sh)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=crmadmin
MYSQL_PASSWORD=crmpassword
MYSQL_DB=crm

# Dev-only JWT signing secret for local session cookies.
JWT_SECRET=local-dev-only-jwt-secret-change-me

# Dummy Entra values so the app boots; real SSO requires GCP/Azure secrets.
ENTRA_CLIENT_ID=local-dev-client-id
ENTRA_TENANT_ID=local-dev-tenant-id

# Point attachment code at the staging bucket name (only used if GCS is exercised).
GCS_ATTACHMENTS_BUCKET=juniper-crm-attachments-staging
