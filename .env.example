# Cloud SQL instance for local proxy (staging used for local dev)
CLOUD_SQL_INSTANCE=

# MySQL (via cloud-sql-proxy on localhost:3306)
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# Azure / Entra ID
GCP_PROJECT=
KMS_GRAPH_TOKEN_KEY=
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=
# Entra app client secret — required for M365 directory search in user admin
ENTRA_CLIENT_SECRET=

# JWT
JWT_SECRET=

# Azure MySql credentials 
AZURE_MYSQL_PASSWORD=
AZURE_DB=
AZURE_MYSQL_HOST=
AZURE_MYSQL_PORT=
AZURE_MYSQL_USER=
AZURE_MYSQL_SSL=

# Aspire 
# --- Aspire integration ---
ASPIRE_ENV=                 # sandbox | prod  (selects which trio below is used)
ASPIRE_SYNC_ENABLED=          # keep false until verified; flip to true to go live
# ASPIRE_SWEEP_INTERVAL=        # optional; failed-sync retry cadence in seconds

# Production
ASPIRE_BASE_URL=
ASPIRE_CLIENT_ID=
ASPIRE_SECRET=

# Sandbox
ASPIRE_SANDBOX_BASE_URL=
ASPIRE_SANDBOX_CLIENT_ID=
ASPIRE_SANDBOX_SECRET=

# --- GCS intake attachments (api/attachments.py) ---
# Bucket holding estimating intake PDFs. REQUIRED in any deployed env —
# defaults to "" and the first upload fails if unset. For local dev point at
# the staging bucket (needs `gcloud auth application-default login`).
GCS_ATTACHMENTS_BUCKET=juniper-crm-attachments-staging
# Service account email used for IAM-signed v4 download URLs (signBlob).
# Set to the Cloud Run runtime SA; it must hold roles/iam.serviceAccountTokenCreator
# on itself and iamcredentials.googleapis.com must be enabled.
# See scripts/provision_gcs_attachments.sh.
GCS_SIGNER_SA_EMAIL=
# Hard cap per uploaded file, in bytes (default 2147483648 = 2 GiB).
GCS_MAX_UPLOAD_BYTES=2147483648
# Signed download-URL lifetime in minutes (default 10).
GCS_SIGNED_URL_TTL_MIN=10
# Comma-separated extra browser origins allowed for API CORS and GCS resumable
# uploads (localhost:5173/5174 are always allowed). In deployed envs set this
# to the app's public origin(s); the bucket CORS config must mirror it.
CORS_EXTRA_ORIGINS=
